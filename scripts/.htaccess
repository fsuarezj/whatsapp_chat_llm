PassengerEnabled on

# Deny access to logs, config, and source files
<FilesMatch "\.(log|py|pyc|pyo|env|venv|cfg|ini|db|sqlite3|json|yml|yaml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to .git and other hidden files/folders
RedirectMatch 404 /\.|^.*~$

# (Optional) Deny access to the tmp and venv folders
RedirectMatch 404 /(\.venv|venv|tmp|logs)/