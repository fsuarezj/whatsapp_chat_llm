# Enable Passenger
PassengerEnabled on
# Deny access to sensitive files
<FilesMatch "\.(log|py|pyc|pyo|env|venv|cfg|ini|db|sqlite3|json|yml|yaml)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to hidden files and backup files
RedirectMatch 404 /\.|^.*~$

# Deny access to sensitive directories
RedirectMatch 404 /(\.venv|venv|tmp|logs)/

# Allow everything else (so Passenger/Flask can handle it)