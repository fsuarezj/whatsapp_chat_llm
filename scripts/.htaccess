# Enable Passenger for this directory
PassengerEnabled on

# Deny access to sensitive file extensions
<FilesMatch "\.(py|pyc|pyo|sh|bat|ps1|log|env|venv|cfg|ini|db|sqlite3|json|yml|yaml|toml|lock|txt|rst|md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to hidden files and backup files
RedirectMatch 404 /\.|^.*~$

# Deny access to sensitive directories
RedirectMatch 404 /(\.venv|venv|logs|build|src|config|test|chat_clients|chatbot|whatsapp_chat_llm\.egg-info|__pycache__)/

# (Optional) Allow access to static files if you add a static/ directory in the future
# <Directory "static">
#     Order allow,deny
#     Allow from all
# </Directory>