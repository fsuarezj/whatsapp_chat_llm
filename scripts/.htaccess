PassengerEnabled on

# Deny access to all files by default
<FilesMatch ".*">
    Order deny,allow
    Deny from all
</FilesMatch>

# Allow access to static files (adjust as needed)
<FilesMatch "\.(css|js|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Order allow,deny
    Allow from all
</FilesMatch>